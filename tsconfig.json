{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    "strict": false,

    "types": ["react", "react-dom"]
  },
  "include": ["src"]
}